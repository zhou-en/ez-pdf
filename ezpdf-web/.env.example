# Auth.js — `npx auth secret` generates one.
AUTH_SECRET=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID, Web).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Preview deployments get a new URL each time, so Auth.js must trust the
# forwarded host. Do NOT set this in production.
# AUTH_TRUST_HOST=true

# Provisioned automatically by `vercel integration add neon`.
DATABASE_URL=

# Provisioned automatically when a Blob store is attached to the project.
BLOB_READ_WRITE_TOKEN=
