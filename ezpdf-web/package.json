{
  "name": "ezpdf-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "dotenv -e .env.local -- drizzle-kit push"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.10.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "packageExtensions": {
      "@auth/drizzle-adapter": {
        "dependencies": {
          "drizzle-orm": "*"
        }
      },
      "drizzle-kit": {
        "dependencies": {
          "drizzle-orm": "*",
          "pg": "*"
        }
      }
    }
  }
}
